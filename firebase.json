{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      ".edge-headless/**",
      ".gitignore",
      "brand-assets/**",
      "functions/**",
      "**/node_modules/**",
      "FIREBASE_SETUP.md",
      "Debugging Notes.txt",
      "**/.*"
    ]
  }
}
